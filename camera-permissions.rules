# /etc/udev/rules.d/99-camera-permissions.rules

# First, set default restrictive permissions for all video devices
ACTION=="add", SUBSYSTEM=="video4linux", MODE="0600", OWNER="root", GROUP="root"

# Rules for 4K camera (update with your actual vendor and product IDs)
KERNEL=="video*", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="082d", SYMLINK+="camera_4k", MODE="0600", OWNER="root", GROUP="root"

# Rules for 1080p camera (update with your actual vendor and product IDs)
KERNEL=="video*", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0825", SYMLINK+="camera_1080p", MODE="0600", OWNER="root", GROUP="root"
