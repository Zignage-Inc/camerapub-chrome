# /etc/udev/rules.d/99-camera-permissions.rules

# Set baseline permissions for all video devices
ACTION=="add", SUBSYSTEM=="video4linux", GROUP="video", MODE="0660", OWNER="root"

# 4K Camera rule
KERNEL=="video*", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="32e4", ATTRS{idProduct}=="0415", \
    SYMLINK+="camera_4k", \
    SYMLINK+="camera_livedooh", \
    GROUP="video", \
    MODE="0660", \
    OWNER="root"

# 1080p Camera rule
KERNEL=="video*", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="32e4", ATTRS{idProduct}=="0577", \
    SYMLINK+="camera_1080p", \
    SYMLINK+="camera_vidireports", \
    GROUP="video", \
    MODE="0660", \
    OWNER="root"

# Ensure symlinks have correct permissions
SYMLINK=="camera_*", GROUP="video", MODE="0660", OWNER="root"
